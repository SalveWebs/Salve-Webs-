!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Salve Webs – Websites to rent or buy</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
<style>
:root{--navy:#04215a;--teal:#00c4a7;--bg:#fcfdff;--surface:#ffffff;--ink:#04215a;--muted:#4a5b82;--line:#d9e0ef;--tealink:#007a68;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#04163f;--surface:#0a2358;--ink:#f2f6ff;--muted:#a9b8da;--line:#1d3677;--tealink:#00c4a7;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#04163f;--surface:#0a2358;--ink:#f2f6ff;--muted:#a9b8da;--line:#1d3677;--tealink:#00c4a7;color-scheme:dark}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
*,*::before,*::after{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:Poppins,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;line-height:1.6}
.wrap{max-width:1040px;margin:0 auto;padding:0 20px}
a{color:inherit}
:focus-visible{outline:3px solid var(--teal);outline-offset:3px}
header{display:flex;align-items:center;justify-content:space-between;padding:14px 0}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none;font-size:1.15rem}
.brand img{width:64px;height:52px;object-fit:contain;border-radius:0}
.brand b{font-weight:700}.brand span{font-weight:300}
.btn{display:inline-block;background:var(--teal);color:#04215a;font-weight:600;text-decoration:none;padding:12px 24px;border-radius:999px;border:0;font-family:inherit;font-size:1rem}
.btn:hover{filter:brightness(1.07)}
.btn.ghost{background:transparent;color:var(--ink);border:2px solid var(--navy)}
@media (prefers-color-scheme:dark){.btn.ghost{border-color:var(--teal)}}
.hero{display:grid;grid-template-columns:1.1fr .9fr;gap:40px;align-items:center;padding:48px 0 72px}
h1{font-size:clamp(2.1rem,5.4vw,3.6rem);line-height:1.1;margin:0 0 18px;font-weight:700;letter-spacing:-.02em}
.hero p{font-size:1.1rem;color:var(--muted);max-width:46ch;margin:0 0 26px}
.cta{display:flex;gap:12px;flex-wrap:wrap}
.win{background:var(--navy);border-radius:16px;padding:44px 14px 14px;position:relative;aspect-ratio:1.15;box-shadow:0 18px 40px rgba(4,33,90,.25)}
.win::before{content:"";position:absolute;top:14px;left:50%;transform:translateX(-50%);width:62%;height:10px;border-radius:99px;background:#fff}
.win .page{background:var(--surface);border-radius:8px;height:100%;padding:18px;display:flex;flex-direction:column;gap:10px}
.win i{display:block;height:12px;border-radius:6px;background:var(--line)}
.win i:nth-child(1){width:55%;height:20px;background:var(--navy)}
.win i:nth-child(2){width:90%}.win i:nth-child(3){width:75%}
.win i:nth-child(4){width:34%;height:30px;background:var(--teal);margin-top:auto}
.cursor{position:absolute;right:12%;bottom:8%;width:64px;filter:drop-shadow(0 4px 6px rgba(0,0,0,.3));animation:nudge 2.4s ease-in-out 1}
@keyframes nudge{0%{transform:translate(-90px,-70px)}60%{transform:translate(4px,4px)}100%{transform:translate(0,0)}}
@media (prefers-reduced-motion:reduce){.cursor{animation:none}html{scroll-behavior:auto}}
section{padding:56px 0;border-top:1px solid var(--line)}
h2{font-size:clamp(1.6rem,3.6vw,2.2rem);margin:0 0 10px;letter-spacing:-.01em}
.lead{color:var(--muted);max-width:60ch;margin:0 0 30px}
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}
.plan{background:var(--surface);border:2px solid var(--navy);border-radius:14px;padding:28px}
.plan.buy{border-color:var(--teal)}
.plan h3{margin:0 0 4px;font-size:1.3rem}
.price{font-size:1.9rem;font-weight:700;margin:6px 0 2px}
.price small{font-size:.95rem;font-weight:400;color:var(--muted)}
.plan p{color:var(--muted);margin:8px 0 0}
.facts{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:20px}
.facts div{border-left:4px solid var(--teal);padding:4px 0 4px 14px}
.facts b{display:block;font-size:1.25rem}.facts span{color:var(--muted);font-size:.95rem}
ul.tick{list-style:none;padding:0;margin:0}
ul.tick li{padding:8px 0 8px 32px;position:relative;border-bottom:1px solid var(--line)}
ul.tick li::before{content:"";position:absolute;left:4px;top:15px;width:16px;height:9px;border-left:3px solid var(--tealink);border-bottom:3px solid var(--tealink);transform:rotate(-45deg)}
.book{display:grid;grid-template-columns:1fr 1fr;gap:36px;align-items:start}
.notice{background:var(--navy);color:#fff;border-left:8px solid var(--teal);border-radius:10px;padding:20px 22px}
.notice b{display:block;margin-bottom:4px;font-size:1.05rem}
footer{border-top:1px solid var(--line);padding:30px 0 40px;color:var(--muted);font-size:.95rem}
footer .wrap{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}
@media (max-width:760px){.hero,.book,.grid,.facts{grid-template-columns:1fr}.hero{padding-top:24px}.win{max-width:420px}}
</style>
</head>
<body>
<div class="wrap">
<header>
  <a class="brand" href="#top" aria-label="Salve Webs home"><img src="data:image/png;base64,





























<a class="btn" href="#book">Book a website</a>
</header>

<main id="top">
<div class="hero">
  <div>
    <h1>A website for your business, ready in 4 to 10 days.</h1>
    <p>We are a small team in India. We design and build websites, then rent them to you by the month or sell them to you outright.</p>
    <div class="cta"><a class="btn" href="#book">How to book</a><a class="btn ghost" href="#pricing">See pricing</a></div>
  </div>
  <div class="win" aria-hidden="true">
    <div class="page"><i></i><i></i><i></i><i></i></div>
    <svg class="cursor" viewBox="0 0 64 64"><path d="M6 4 L58 30 L36 34 L48 56 L38 62 L26 40 L10 54 Z" fill="#00c4a7" stroke="#fff" stroke-width="4" stroke-linejoin="round"/></svg>
  </div>
</div>

<section id="what">
  <h2>What we do</h2>
  <p class="lead">You tell us about your business. We build the website for it. Then you either rent it from us and pay monthly, or buy it and own it.</p>
  <ul class="tick">
    <li>Custom websites for shops, services, freelancers and small businesses</li>
    <li>Rent a site with a low monthly fee, or buy it once</li>
    <li>10 edits included with every website, then ₹50 for each extra edit</li>
    <li>Built by two people who answer your emails ourselves</li>
  </ul>
</section>

<section id="pricing">
  <h2>Pricing</h2>
  <p class="lead">The final price depends on what your website needs. Email us your requirements and we will quote you within that range.</p>
  <div class="grid">
    <div class="plan">
      <h3>Rent a website</h3>
      <div class="price">₹700 – ₹10,000 <small>per month</small></div>
      <p>Lower cost to start. We host and keep your website running for as long as you rent it.</p>
    </div>
    <div class="plan buy">
      <h3>Buy a website</h3>
      <div class="price">₹5,000 – ₹50,000 <small>one time</small></div>
      <p>Pay once, and the website is yours.</p>
    </div>
  </div>
  <div class="facts">
    <div><b>10 edits</b><span>included in the fee, for rent or sale. Each extra edit costs ₹50.</span></div>
    <div><b>4 – 10 days</b><span>to build, based on the size of the site</span></div>
    <div><b>Rent or buy</b><span>you choose what suits your budget</span></div>
  </div>
</section>

<section id="book">
  <h2>How to book</h2>
  <div class="book">
    <div>
      <p class="lead">To rent or buy a website, send one email to <a href="mailto:salvewebs@gmail.com"><b>salvewebs@gmail.com</b></a> with:</p>
      <ul class="tick">
        <li>Your business name and what it does</li>
        <li>Your logo</li>
        <li>Your address</li>
        <li>Your contact info (phone and email)</li>
        <li>Everything you want on the website</li>
        <li>Whether you want to rent or buy</li>
      </ul>
    </div>
    <div>
      <div class="notice" role="note"><b>Please note</b>Anything you do not put in your email will not be on your website. Include every page, feature and detail you need before you send it.</div>
      <p style="margin:24px 0 12px;color:var(--muted)">Tap the button to open an email with these details ready to fill in.</p>
      <a class="btn" id="mail" href="#">Email us to book</a>
    </div>
  </div>
</section>
</main>
</div>

<footer>
  <div class="wrap">
    <span>© Salve Webs</span>
    <a href="mailto:salvewebs@gmail.com">salvewebs@gmail.com</a>
  </div>
</footer>
<script>
(function(){
  var body = "Hello Salve Webs,\n\nI would like to book a website.\n\nRent or buy: \nBusiness name and what it does: \nLogo: (attached)\nAddress: \nContact info: \nThings I want on the website: \n\nThank you.";
  document.getElementById("mail").href = "mailto:salvewebs@gmail.com?subject=" + encodeURIComponent("Website booking enquiry") + "&body=" + encodeURIComponent(body);
})();
</script>
</body>
</html>
